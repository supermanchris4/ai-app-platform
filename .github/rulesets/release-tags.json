{
  "name": "release tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/api-v*.*.*",
        "refs/tags/web-v*.*.*",
        "refs/tags/mock-idp-v*.*.*",
        "refs/tags/terraform-v*.*.*",
        "refs/tags/workflows-v*.*.*"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "update" }
  ]
}
